# AI (optional — the free half of the tool works without it)
OPENROUTER_API_KEY=
# Free models are tried first; if they are rate-limited, the cheapest paid ones are used.
OPENROUTER_FREE_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_MODELS=qwen/qwen3-30b-a3b-instruct-2507,mistralai/mistral-nemo,google/gemma-3-12b-it

# Abuse protection
# AI calls per visitor per hour
RATE_PER_IP=8
# AI calls per day for the whole site (hard ceiling)
DAILY_CAP=400
# comma-separated; blocks other sites calling your API
ALLOWED_ORIGINS=https://silk-bored.vercel.app
# Cloudflare Turnstile (free) — invisible bot check
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# makes the limits global across serverless instances (free tier is plenty)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

SITE_URL=https://silk-bored.vercel.app
SITE_NAME=Silk Bored
